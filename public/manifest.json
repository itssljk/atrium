{
  "manifest_version": 3,
  "name": "Atrium Tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "atrium-tabs@itssljk",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "version": "1.0.0",
  "description": "A clean, minimal, and ambient-themed browser start page with dynamic greetings, quick search, and custom controls.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://search.brave.com/*",
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://picsum.photos/*",
    "https://www.bing.com/*",
    "https://zenquotes.io/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "512": "icon-512.png"
  }
}
